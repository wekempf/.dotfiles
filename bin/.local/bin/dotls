#!/usr/bin/env bash

set -euo pipefail

if [[ -z "${DOTFILES:-}" ]]; then
  if [[ -d "$HOME/.dotfiles" ]]; then
    DOTFILES="$HOME/.dotfiles"
  else
    echo "Error: DOTFILES environment variable is not set." >&2
    exit 1
  fi
fi

DOTFILES="$(cd -- "$DOTFILES" && pwd -P)"

find "$DOTFILES" -mindepth 1 -maxdepth 1 -type d \
  ! -name '.*' \
  ! -name '__*' \
  -printf '%f\n' | sort