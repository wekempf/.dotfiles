#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
DOTFILES="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"

case ":$PATH:" in
	*":$HOME/.local/bin:"*)
		echo "PATH: ~/.local/bin already present"
		;;
	*)
		export PATH="$HOME/.local/bin:$PATH"
		echo "PATH: added ~/.local/bin"
		;;
esac

stow --dir "$DOTFILES" --target "$HOME" --restow --verbose bin